
# General ignores
.DS_Store
Thumbs.db
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.sqlite
*.sqlite3

# Frontend specific ignores (assuming 'frontend' directory)
/frontend/node_modules/
/frontend/build/
/frontend/dist/
/frontend/out/
/frontend/.next/ # Next.js specific
/frontend/.nuxt/ # Nuxt.js specific
/frontend/.parcel-cache/ # Parcel specific
/frontend/public/build/ # Common build output
/frontend/.env
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# Backend specific ignores (assuming 'backend' directory)
/backend/node_modules/ # For Node.js backend
/backend/venv/ # For Python virtual environments
/backend/.venv/ # For Python virtual environments
/backend/__pycache__/ # For Python
/backend/target/ # For Java/Maven/Gradle builds
/backend/bin/ # For compiled binaries
/backend/build/ # General build output
/backend/dist/ # General distribution output
/backend/.env
/backend/.env.local
/backend/*.log
/backend/logs/
/backend/*.sqlite
/backend/*.sqlite3
/backend/tmp/
/backend/output
/backend/uploads

# Extra ignores
venv/
.venv/
backend/venv/

